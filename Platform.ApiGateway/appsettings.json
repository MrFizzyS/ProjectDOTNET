{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-api",
        "Order": 0,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-api",
        "Order": 0,
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-api",
        "Order": 0,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "aggregator-fallback-route": {
  "ClusterId": "aggregator",
  "Order": 100,
  "Match": {
    "Path": "/aggregator/{**catch-all}"
  },
  "Transforms": [
    {
      "PathRemovePrefix": "/aggregator"
    }
  ]
}
    },
    "Clusters": {
      "orders-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders-api/"
          }
        }
      },
      "catalog-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api/"
          }
        }
      },
      "reviews-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-api/"
          }
        }
      },
      "aggregator": {
        "Destinations": {
          "destination1": {
            "Address": "http://aggregator/"
          }
        }
      }
    }
  }
}